\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Selected autocorrelation fit residuals, normalized by the measured range in the fitted interval. Structured residuals remain after nonlinear fringe calibration and indicate that covariance errors alone understate uncertainty. Uncertainties on the displayed RMS diagnostics have not been estimated.}}{25}{figure.12}\protected@file@percent }
\newlabel{fig:iac-residuals}{{12}{25}{Selected autocorrelation fit residuals, normalized by the measured range in the fitted interval. Structured residuals remain after nonlinear fringe calibration and indicate that covariance errors alone understate uncertainty. Uncertainties on the displayed RMS diagnostics have not been estimated}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Local fringe frequency during the selected before- and after-compressor autocorrelation scans. Blue points give the inverse recorded-time separation between successive raw-signal maxima, $f_i=1/(x_{i+1}-x_i)$, placed at the interval midpoint. The red curve is the derivative of the fitted cubic mapping from recorded time to optical-delay cycles. The dashed horizontal line shows the central frequency used in a constant-speed approximation. Toward the scan edges, the fringes are farther apart in recorded time and their local frequency decreases, supporting a nonlinear time-to-optical-delay calibration for pulse-width extraction. This frequency describes the recorded interference fringes, rather than the optical carrier frequency of the laser. Pointwise frequency uncertainties are unquantified; the plot is a calibration diagnostic.}}{26}{figure.13}\protected@file@percent }
\newlabel{fig:fringe-calibration}{{13}{26}{Local fringe frequency during the selected before- and after-compressor autocorrelation scans. Blue points give the inverse recorded-time separation between successive raw-signal maxima, $f_i=1/(x_{i+1}-x_i)$, placed at the interval midpoint. The red curve is the derivative of the fitted cubic mapping from recorded time to optical-delay cycles. The dashed horizontal line shows the central frequency used in a constant-speed approximation. Toward the scan edges, the fringes are farther apart in recorded time and their local frequency decreases, supporting a nonlinear time-to-optical-delay calibration for pulse-width extraction. This frequency describes the recorded interference fringes, rather than the optical carrier frequency of the laser. Pointwise frequency uncertainties are unquantified; the plot is a calibration diagnostic}{figure.13}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B}Population and transport model diagnostics}{27}{appendix.B}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Checks motivated by Section IV of Chen et al. Top: PP residuals for the baseline biexponential-plus-constant fit and an empirical three-exponential-plus-constant alternative. The extra slow term reduces the systematic long-time residual but does not identify its physical origin. Bottom: separately regressed fast and slow TG rates; error bars are conditional 95\% whole-scan bootstrap intervals. Nominal wave-number calibration uncertainties are unavailable. Both branches would have equal slopes under a shared diffusivity.}}{27}{figure.14}\protected@file@percent }
\newlabel{fig:paper-model-diagnostics}{{14}{27}{Checks motivated by Section IV of Chen et al. Top: PP residuals for the baseline biexponential-plus-constant fit and an empirical three-exponential-plus-constant alternative. The extra slow term reduces the systematic long-time residual but does not identify its physical origin. Bottom: separately regressed fast and slow TG rates; error bars are conditional 95\% whole-scan bootstrap intervals. Nominal wave-number calibration uncertainties are unavailable. Both branches would have equal slopes under a shared diffusivity}{figure.14}{}}
